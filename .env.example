# ==============================================================================
# Physics Wallah (PW) GATE Predictor Platform - Environment Configuration
# Copy this file to .env and customize as needed.
# ==============================================================================

# Application Environment (development | production | testing)
ENVIRONMENT=production

# Server Binding
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database Configuration
# Default: High-concurrency SQLite with Write-Ahead Logging (WAL) and 64MB RAM cache.
# To connect to external PostgreSQL, replace with:
# DATABASE_URL=postgresql://username:password@localhost:5432/gate_predictor_db
DATABASE_URL=sqlite:///./gate_predictor.db

# Counsellor Operations Defaults
DEFAULT_COUNSELLOR_NAME="PW Admissions Mentor"

# CORS Configuration (* allows access from all origins, or set comma-separated domains)
CORS_ORIGINS="*"

# Logging Level (debug | info | warning | error)
LOG_LEVEL=info
